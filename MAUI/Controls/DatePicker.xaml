<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MAUI.Controls.DatePicker"
             x:Name="CustomDatePicker">

    <Border
        Stroke="{AppThemeBinding Default={StaticResource Primary500}}"
        StrokeThickness="2"
        Padding="0"
        HorizontalOptions="Fill">
        <DatePicker
            x:Name="InternalDatePicker"
            Date="{Binding Source={x:Reference CustomDatePicker}, Path=Date, Mode=TwoWay}"
            Format="{Binding Source={x:Reference CustomDatePicker}, Path=DateFormat}"
            MinimumDate="{Binding Source={x:Reference CustomDatePicker}, Path=MinimumDate}"
            MaximumDate="{Binding Source={x:Reference CustomDatePicker}, Path=MaximumDate}"
            HorizontalOptions="Fill"
            VerticalOptions="Center"
            BackgroundColor="Transparent"
            TextColor="{AppThemeBinding Default={StaticResource Black}, Dark={StaticResource White}}"
            FontSize="16"
            />
    </Border>
</ContentView>
